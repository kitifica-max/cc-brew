# .env.example — copiar a ~/.config/cc-controller/.env (o desktop/.env en dev)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGc...   # service_role key (nunca al cliente)
SESSION_ID=your-session-id
SESSION_TOKEN=genera-uno-con-openssl-rand-hex-32
PWA_URL=tu-app.netlify.app
# CLAUDE_TIMEOUT_MS=600000         # opcional: límite por mensaje (10 min por defecto)

# En Netlify: estas van como env vars del proyecto
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
NEXT_PUBLIC_SESSION_ID=your-session-id
# NEXT_PUBLIC_SESSION_TOKEN ya no existe: sería público. El token se introduce
# una sola vez en la PWA y se guarda en el dispositivo.
