# Supabase (Project Settings → API)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_KEY="your-service-role-key"

# Session — SESSION_ID va también en la PWA (NEXT_PUBLIC_SESSION_ID).
# SESSION_TOKEN se introduce a mano en la PWA la primera vez; nunca en el build.
SESSION_ID="cc-session-01"
SESSION_TOKEN="genera-uno-con: openssl rand -hex 32"

# Límite por mensaje en milisegundos (10 min por defecto)
# CLAUDE_TIMEOUT_MS="600000"

# URL de la PWA desplegada (sin https://)
PWA_URL="ccc.kitifica.com"
