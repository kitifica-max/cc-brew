# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Identificador del canal — debe coincidir con SESSION_ID de desktop/.env
NEXT_PUBLIC_SESSION_ID="cc-session-01"

# Auth Hook "Send Email" (Supabase → Authentication → Hooks). Sin este secreto
# el endpoint /api/auth/send-email rechaza todas las peticiones.
SEND_EMAIL_HOOK_SECRET="v1,whsec_..."
RESEND_API_KEY="re_..."

# Gemini API — para transcripción de voz (STT)
# Obtener en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="AIza..."

# El SESSION_TOKEN NO va aquí: cualquier variable NEXT_PUBLIC_* acaba en el
# JavaScript público. Se introduce una vez en la PWA y se guarda en el
# dispositivo.
